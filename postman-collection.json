{
  "info": {
    "name": "Remotion HTTP Server",
    "description": "API collection for Remotion presentation rendering server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3004"
    },
    {
      "key": "previewPort",
      "value": "3005"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Check if the server is running"
      }
    },
    {
      "name": "Create Presentation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filepath\": \"./input/my-presentation.json\",\n  \"presentation\": {\n    \"title\": \"My Video\",\n    \"theme\": \"default\",\n    \"slides\": [\n      {\n        \"id\": \"slide-1\",\n        \"layout\": \"title-slide\",\n        \"blocks\": [\n          {\n            \"type\": \"text\",\n            \"content\": \"Welcome to My Presentation\"\n          }\n        ]\n      }\n    ]\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/create-presentation",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "create-presentation"
          ]
        },
        "description": "Create a new presentation JSON file"
      }
    },
    {
      "name": "Start Preview",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/preview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "preview"
          ]
        },
        "description": "Start the preview server (opens at http://localhost:3005)"
      }
    },
    {
      "name": "Stop Preview",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/preview/stop",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "preview",
            "stop"
          ]
        },
        "description": "Stop the running preview server"
      }
    },
    {
      "name": "Render Video",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": \"./input/sample-presentation.json\",\n  \"output\": \"./output/video.mp4\",\n  \"language\": \"en\",\n  \"width\": 1920,\n  \"height\": 1080,\n  \"fps\": 30,\n  \"codec\": \"h264\",\n  \"audio\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/render",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "render"
          ]
        },
        "description": "Render a presentation to video file. Audio can be disabled with audio: false"
      }
    }
  ]
}
